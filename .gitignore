# OS
.DS_Store

# Editor
.vscode/
.idea/

# Environment
.env
.env.local

# Secrets
*.secret
credentials.json
*credentials*.csv
oshikatu-credentials.csv

# Temp
*.tmp
*.log

# Node
node_modules/

# Output (scraped data)
output/blog/raw/
# output/wordpress/ 配下は基本無視（大容量ダンプ等）。ただし子テーマだけは追跡する
# theme/  … 編集対象の子テーマ（本番 cocoon-child-master に対応・git追跡）
# exports/… ライブサイトから採取したAPIダンプ・デザイン資料（無視）
output/wordpress/*
!output/wordpress/theme
.env
